# Normally generated by Terraform. Copy to hosts.yml if you create the VMs by hand.
all:
  vars:
    ansible_user: debian
    lab_domain: lab.example
  children:
    elasticsearch:
      hosts:
        es-01: { ansible_host: 10.0.0.11 }
        es-02: { ansible_host: 10.0.0.12 }
        es-03: { ansible_host: 10.0.0.13 }
    apps:
      hosts:
        apps-01: { ansible_host: 10.0.0.20 }
    otel_gateway:
      children:
        elasticsearch: {}
