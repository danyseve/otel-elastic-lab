# Copy to terraform.tfvars (git-ignored) and adapt. All values below are examples.
# API only: no SSH to the hypervisors and no snippets datastore are needed.
# The token should carry the minimum role over a pool (see docs/adr/0006).

proxmox_endpoint  = "https://pve.example.internal:8006/"
proxmox_api_token = "terraform@pve!otel-lab=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = true

pool_id = "otel-lab"

network_gateway = "10.0.0.1"
dns_servers     = ["10.0.0.1"]
domain          = "lab.example"
# Tag for the lab VLAN. Requires a VLAN-aware bridge; null = untagged.
network_vlan = 10

# Datastore that holds the imported cloud image. It must be readable from every
# hypervisor that hosts a VM: with node-local storage (default "local") all three
# VMs must live on image_node, so point it at shared storage in that case.
image_datastore = "local"
# Hypervisor that imports the image. Empty = node of the first VM by name.
# image_node = "node-1"

ssh_public_keys = [
  "ssh-ed25519 AAAA... you@workstation",
]

# Three k3s nodes, one per hypervisor host.
vms = {
  k8s-01 = { node = "node-1", vm_id = 901, ip = "10.0.0.11", cores = 6, memory_mb = 16384, disk_gb = 150 }
  k8s-02 = { node = "node-2", vm_id = 902, ip = "10.0.0.12", cores = 6, memory_mb = 16384, disk_gb = 150 }
  k8s-03 = { node = "node-3", vm_id = 903, ip = "10.0.0.13", cores = 6, memory_mb = 16384, disk_gb = 150 }
}
