locals {
  # Inventory handed over to Ansible (git-ignored: it contains your real IPs).
  # Hosts outside the cluster (the apps) go in a separate, hand-written file.
  ansible_inventory = {
    all = {
      vars = {
        ansible_user = var.ssh_user
        lab_domain   = var.domain
      }
      children = {
        k3s_servers = {
          hosts = { for name, vm in var.vms : name => { ansible_host = vm.ip } }
        }
      }
    }
  }

  # Node that imports the cloud image, unless image_node is set explicitly.
  image_node = var.image_node != "" ? var.image_node : var.vms[sort(keys(var.vms))[0]].node
}

# The image is imported once through the API and reused by every VM. No snippets
# datastore and no SSH: cloud-init is generated by the provider (see initialization
# in the VM resource). The datastore must be readable from every node that hosts a
# VM, so shared storage is recommended (ADR-0006).
resource "proxmox_virtual_environment_download_file" "debian_cloud_image" {
  node_name    = local.image_node
  content_type = "iso"
  datastore_id = var.image_datastore
  url          = var.debian_image_url
  file_name    = "debian-13-genericcloud-amd64.img"
  overwrite    = false
}

resource "proxmox_virtual_environment_vm" "this" {
  for_each = var.vms

  name        = each.key
  node_name   = each.value.node
  vm_id       = each.value.vm_id
  pool_id     = var.pool_id
  description = "Managed by Terraform - otel-elastic-lab"
  tags        = ["otel-lab", "terraform", "k3s"]
  on_boot     = true
  started     = true

  machine       = "q35"
  scsi_hardware = "virtio-scsi-single"

  # The guest agent is installed by Ansible (role 'common') on first boot, so it
  # is disabled here: enabling it before installation breaks backups and shows
  # warnings on every clone.
  agent {
    enabled = false
  }

  # 'host' exposes AVX/SIMD to the guest; Elasticsearch uses it.
  cpu {
    cores = each.value.cores
    type  = "host"
  }

  # floating = 0 disables the balloon driver: the JVM heap must not be reclaimed.
  memory {
    dedicated = each.value.memory_mb
    floating  = 0
  }

  disk {
    datastore_id = var.vm_datastore
    file_id      = proxmox_virtual_environment_download_file.debian_cloud_image.id
    interface    = "scsi0"
    iothread     = true
    discard      = "on"
    ssd          = true
    size         = each.value.disk_gb
  }

  network_device {
    bridge  = var.network_bridge
    model   = "virtio"
    vlan_id = var.network_vlan
  }

  operating_system {
    type = "l26"
  }

  serial_device {}

  initialization {
    datastore_id = var.vm_datastore

    ip_config {
      ipv4 {
        address = "${each.value.ip}/${var.network_prefix}"
        gateway = var.network_gateway
      }
    }

    dns {
      domain  = var.domain
      servers = var.dns_servers
    }

    # Replaces the cloud-init snippet that required a snippets datastore and an
    # SSH connection to the hypervisor.
    user_account {
      username = var.ssh_user
      keys     = [for k in var.ssh_public_keys : trimspace(k)]
    }
  }
}

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/k3s.yml"
  file_permission = "0644"
  content         = "# Generated by Terraform - do not edit.\n${yamlencode(local.ansible_inventory)}"

  depends_on = [proxmox_virtual_environment_vm.this]
}
