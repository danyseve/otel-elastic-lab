locals {
  hypervisor_nodes = toset([for vm in values(var.vms) : vm.node])

  # Inventory handed over to Ansible (git-ignored: it contains your real IPs).
  # Hosts outside the cluster (the apps) go in a separate, hand-written file.
  ansible_inventory = {
    all = {
      vars = {
        ansible_user = var.ssh_user
        lab_domain   = var.domain
      }
      children = {
        k3s_servers = {
          hosts = { for name, vm in var.vms : name => { ansible_host = vm.ip } }
        }
      }
    }
  }
}

# One copy of the cloud image per hypervisor host (local storage is not shared).
resource "proxmox_virtual_environment_download_file" "debian_cloud_image" {
  for_each = local.hypervisor_nodes

  node_name    = each.value
  content_type = "iso"
  datastore_id = var.image_datastore
  url          = var.debian_image_url
  file_name    = "debian-13-genericcloud-amd64.img"
  overwrite    = false
}

resource "proxmox_virtual_environment_file" "user_data" {
  for_each = var.vms

  node_name    = each.value.node
  content_type = "snippets"
  datastore_id = var.snippets_datastore

  source_raw {
    file_name = "${each.key}-user-data.yaml"
    data = templatefile("${path.module}/templates/user-data.yaml.tftpl", {
      hostname       = each.key
      domain         = var.domain
      timezone       = var.timezone
      ssh_user       = var.ssh_user
      ssh_public_key = trimspace(var.ssh_public_key)
    })
  }
}

resource "proxmox_virtual_environment_vm" "this" {
  for_each = var.vms

  name        = each.key
  node_name   = each.value.node
  vm_id       = each.value.vm_id
  description = "Managed by Terraform - otel-elastic-lab"
  tags        = ["otel-lab", "terraform", "k3s"]
  on_boot     = true
  started     = true

  machine       = "q35"
  scsi_hardware = "virtio-scsi-single"

  agent {
    enabled = true
  }

  # 'host' exposes AVX/SIMD to the guest; Elasticsearch uses it.
  cpu {
    cores = each.value.cores
    type  = "host"
  }

  # floating = 0 disables the balloon driver: the JVM heap must not be reclaimed.
  memory {
    dedicated = each.value.memory_mb
    floating  = 0
  }

  disk {
    datastore_id = var.vm_datastore
    file_id      = proxmox_virtual_environment_download_file.debian_cloud_image[each.value.node].id
    interface    = "scsi0"
    iothread     = true
    discard      = "on"
    ssd          = true
    size         = each.value.disk_gb
  }

  network_device {
    bridge = var.network_bridge
    model  = "virtio"
  }

  operating_system {
    type = "l26"
  }

  serial_device {}

  initialization {
    datastore_id = var.vm_datastore

    ip_config {
      ipv4 {
        address = "${each.value.ip}/${var.network_prefix}"
        gateway = var.network_gateway
      }
    }

    dns {
      domain  = var.domain
      servers = var.dns_servers
    }

    user_data_file_id = proxmox_virtual_environment_file.user_data[each.key].id
  }
}

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/k3s.yml"
  file_permission = "0644"
  content         = "# Generated by Terraform - do not edit.\n${yamlencode(local.ansible_inventory)}"

  depends_on = [proxmox_virtual_environment_vm.this]
}
